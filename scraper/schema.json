{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PublicNotificationNotice",
  "type": "object",
  "required": ["title", "link", "date", "category"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Headline or notice title"
    },
    "link": {
      "type": "string",
      "format": "uri",
      "description": "Full URL to official notice or document"
    },
    "date": {
      "type": "string",
      "description": "Publication or effective date of notice"
    },
    "category": {
      "type": "string",
      "description": "Category or topic tag (e.g. Launch, Security, General)"
    },
    "summary": {
      "type": "string",
      "description": "Brief notice summary"
    },
    "reference_id": {
      "type": "string",
      "description": "Unique identifier or reference code"
    },
    "source_url": {
      "type": "string",
      "description": "Origin domain or seed URL"
    },
    "raw_html": {
      "type": "string",
      "description": "Raw HTML source of the document"
    },
    "raw_lines": {
      "type": "integer",
      "description": "Line count of raw HTML"
    },
    "raw_bytes": {
      "type": "integer",
      "description": "Byte count of raw HTML"
    },
    "open_graph": {
      "type": "object",
      "description": "Extracted OpenGraph and social metadata"
    },
    "meta_tags": {
      "type": "object",
      "description": "Key-value dictionary of extracted HTML meta tags"
    },
    "json_ld": {
      "type": "array",
      "description": "Parsed JSON-LD structured schemas"
    },
    "waf_info": {
      "type": "object",
      "description": "Anti-bot and Web Application Firewall diagnostic details"
    }
  }
}
