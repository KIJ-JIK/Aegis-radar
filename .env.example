# Bright Data & Aegis Environment Configuration

# Bright Data Credentials / Collector Configuration
BRIGHTDATA_API_KEY=your_bright_data_api_key_here
BRIGHTDATA_COLLECTOR_ID=your_collector_id_here
TARGET_URL=https://aws.amazon.com/new/

# Gemini AI API Key for Insight Summarization Agent
GEMINI_API_KEY=your_gemini_api_key_here

# Notification Webhooks
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
TELEGRAM_BOT_TOKEN=optional_telegram_bot_token
TELEGRAM_CHAT_ID=optional_telegram_chat_id
