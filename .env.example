# ==============================================================================
# AEGIS SCRAPEVERSE RADAR — ENVIRONMENT CONFIGURATION
# 100% Free-Tier Services Configuration
# ==============================================================================

# 1. Supabase Auth (Free Tier - 50,000 MAU)
# Obtain from: https://supabase.com -> New Project -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. MongoDB Atlas (Free M0 Shared Cluster - 512MB)
# Obtain from: https://www.mongodb.com/cloud/atlas -> Connect -> Drivers -> Node.js Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=aegis_radar

# 3. AI Insight & Summarizer API (Gemini AI)
# Obtain free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# 4. Bright Data Scraper Studio (Hackathon Title Sponsor Core)
BRIGHTDATA_COLLECTOR_ID=c_msymq29htvadbnxko
BRIGHTDATA_API_KEY=your-brightdata-api-key-optional

# 5. Alert Notifications (Optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# 6. Default Target URL
TARGET_URL=https://aws.amazon.com/new/
